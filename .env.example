# EWOS backend — environment variables reference.
# Copy to .env for local docker-compose use, or set these directly in your
# deployment platform (Kubernetes Secret/ConfigMap, ECS task definition, etc).
# Values below marked "REQUIRED in prod" have no safe default and the
# application refuses to boot without them once SPRING_PROFILES_ACTIVE=prod.

# ---- Runtime profile --------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev            # dev | test | prod
SERVER_PORT=8080

# ---- Database (REQUIRED in prod; dev/test have compose/embedded defaults) --
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ewos
SPRING_DATASOURCE_USERNAME=ewos
SPRING_DATASOURCE_PASSWORD=ewos
DB_POOL_MAX=20
DB_POOL_MIN=5

# ---- Redis (session/rate-limit backing store) -------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Kafka (optional — off by default, see KafkaConfig) ---------------------
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_MESSAGING_KAFKA_ENABLED=false

# ---- JWT (REQUIRED in prod: random value, >= 32 bytes, no placeholder text) -
# See JwtSecretGuard — refuses to boot in prod/staging with a short or
# placeholder-looking secret. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-please-use-a-256-bit-secret-in-production-environments
JWT_ISSUER=ewos
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Bootstrap System Administrator (REQUIRED in prod: real password) ------
# See AdminPasswordGuard — refuses to boot in prod/staging if this is still
# the ChangeMe!Admin123 placeholder shipped for dev/test.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ewos.local
ADMIN_PASSWORD=ChangeMe!Admin123

# ---- Password policy ---------------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_SIZE=5

# ---- Login lockout / rate limiting -------------------------------------------
AUTH_LOCKOUT_ENABLED=true
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=15m
AUTH_RATELIMIT_ENABLED=true
AUTH_RATELIMIT_MAX_ATTEMPTS=60
AUTH_RATELIMIT_WINDOW=1m

# ---- CORS (REQUIRED in prod: explicit origin list, no wildcard — ADR-0004) --
APP_CORS_ALLOWED_ORIGINS=https://app.example.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE=1h

# ---- Retention/purge jobs (off by default) -----------------------------------
APP_PURGE_ENABLED=false
APP_PURGE_CRON=0 15 3 * * *
APP_PURGE_ZONE=UTC
APP_PURGE_REFRESH_RETENTION=30d
APP_PURGE_SOFT_DELETE_RETENTION=365d
APP_PURGE_REFRESH_ENABLED=false
APP_PURGE_SOFT_DELETE_ENABLED=false
